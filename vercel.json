{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run sync:config",
  "outputDirectory": "frontend",
  "regions": ["iad1"],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "backend/lib/**/*",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/shared/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }]
    }
  ]
}
